<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:m="using:Gallery.Models"
             x:Class="Gallery.Views.Live.LiveRadar" x:DataType="m:LiveFamilies">
  <Border Classes="card">
    <StackPanel Spacing="8">
      <TextBlock Classes="title" Text="Radar chart" />
      <TextBlock Classes="muted small" Text="{Binding Updated}" />
      <p:RadarChart Data="{Binding Subjects}" MaxWidth="500" Aspect="1.25" OuterRadius="80%">
        <p:PolarGrid />
        <p:PolarAngleAxis DataKey="Name" />
        <p:PolarRadiusAxis />
        <p:Tooltip />
        <p:Radar Name="Mike" DataKey="A" Stroke="#8884d8" Fill="#8884d8" FillOpacity="0.6" />
        <p:Radar Name="Lily" DataKey="B" Stroke="#82ca9d" Fill="#82ca9d" FillOpacity="0.6" />
      </p:RadarChart>
    </StackPanel>
  </Border>
</UserControl>
