<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:m="using:Gallery.Models"
             x:Class="Gallery.Views.Live.LiveSankey" x:DataType="m:LiveFamilies">
  <Border Classes="card">
    <StackPanel Spacing="8">
      <TextBlock Classes="title" Text="Sankey" />
      <TextBlock Classes="muted small" Text="{Binding Updated}" />
      <p:Sankey Data="{Binding Visits}" MaxWidth="800" Aspect="2" Padding="0,0,0,30" NodePadding="50" LinkStroke="#77c878">
        <p:Tooltip />
      </p:Sankey>
    </StackPanel>
  </Border>
</UserControl>
