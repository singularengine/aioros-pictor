<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:m="using:Gallery.Models"
             x:Class="Gallery.Views.Live.LivePie" x:DataType="m:LiveFamilies">
  <Border Classes="card">
    <StackPanel Spacing="8">
      <TextBlock Classes="title" Text="Pie chart" />
      <TextBlock Classes="muted small" Text="{Binding Updated}" />
      <p:PieChart Data="{Binding Groups}" MaxWidth="400" Aspect="1.3333333333333333">
        <p:Pie DataKey="Value" NameKey="Name" OuterRadius="100" Fill="#8884d8" Label="True" />
        <p:Tooltip />
      </p:PieChart>
    </StackPanel>
  </Border>
</UserControl>
