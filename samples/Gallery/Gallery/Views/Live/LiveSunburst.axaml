<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:m="using:Gallery.Models"
             x:Class="Gallery.Views.Live.LiveSunburst" x:DataType="m:LiveFamilies">
  <Border Classes="card">
    <StackPanel Spacing="8">
      <TextBlock Classes="title" Text="Sunburst chart" />
      <TextBlock Classes="muted small" Text="{Binding Updated}" />
      <p:SunburstChart Data="{Binding Tree}" MaxWidth="500" Aspect="1" FillKey="Fill">
        <p:Tooltip />
      </p:SunburstChart>
    </StackPanel>
  </Border>
</UserControl>
