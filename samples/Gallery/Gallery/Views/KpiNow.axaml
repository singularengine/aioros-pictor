<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:an="using:Gallery.Analytics"
             x:Class="Gallery.Views.KpiNow" x:DataType="an:KpiNowModel">
  <Border Classes="card tile">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="livedot" VerticalAlignment="Center" />
        <TextBlock Classes="label" Text="{Binding Data.Label}" />
      </StackPanel>
      <WrapPanel Grid.Row="1" ItemSpacing="10" LineSpacing="4">
        <TextBlock Classes="kpi hero" Text="{Binding Data.Value}" />
        <Border Classes="pill" Classes.good="{Binding Data.Good}" Classes.bad="{Binding Data.Bad}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Data.Delta}" />
        </Border>
      </WrapPanel>
      <p:AreaChart Grid.Row="2" Data="{Binding Data.Trend}" Height="44" Padding="0,4,0,2" ResponsiveWidths="240 340" VerticalAlignment="Bottom">
        <p:YAxis Hide="True" Domain="dataMin, dataMax" />
        <p:Area Type="Linear" DataKey="Value" Stroke="{DynamicResource PictorPalette1}" Fill="{DynamicResource SparkFade}" FillOpacity="1" StrokeWidth="2" Dot="False" ActiveDot="0" IsAnimationActive="False" />
      </p:AreaChart>
      <TextBlock Grid.Row="3" Classes="muted small" Text="{Binding Data.Caption}" />
    </Grid>
  </Border>
</UserControl>
