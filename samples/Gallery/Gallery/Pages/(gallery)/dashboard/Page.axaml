<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:an="using:Gallery.Analytics" xmlns:v="using:Gallery.Views" xmlns:a="https://aioros.dev"
             x:DataType="an:DashboardModel" a:Page.Title="Live analytics" a:Web.Live="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:String x:Key="PictorPalette1">#2a78d6</x:String>
          <x:String x:Key="PictorPalette2">#eb6834</x:String>
          <x:String x:Key="PictorPalette3">#1baf7a</x:String>
          <x:String x:Key="PictorPalette4">#eda100</x:String>
          <x:String x:Key="PictorPalette5">#e87ba4</x:String>
          <x:String x:Key="PictorGridStroke">#ececef</x:String>
          <x:String x:Key="PictorTickText">#8b8b94</x:String>
          <x:String x:Key="PictorCursorStroke">#d4d4d8</x:String>
          <x:String x:Key="PictorCursorFill">#f4f4f5</x:String>
          <x:String x:Key="PictorTooltipBackground">#ffffff</x:String>
          <x:String x:Key="PictorTooltipBorder">#e6e6ea</x:String>
          <x:String x:Key="PictorTooltipLabel">#111113</x:String>
          <x:String x:Key="PictorPieStroke">#ffffff</x:String>
          <x:String x:Key="PictorFunnelStroke">#ffffff</x:String>
          <x:String x:Key="PictorBrushStroke">#a1a1aa</x:String>
          <x:String x:Key="PictorBrushFill">#ffffff</x:String>
          <x:String x:Key="Step1">#1c5cab</x:String>
          <x:String x:Key="Step2">#2a78d6</x:String>
          <x:String x:Key="Step3">#5598e7</x:String>
          <x:String x:Key="Step4">#86b6ef</x:String>
          <SolidColorBrush x:Key="Series1" Color="#2a78d6" />
          <SolidColorBrush x:Key="Series2" Color="#eb6834" />
          <SolidColorBrush x:Key="Series3" Color="#1baf7a" />
          <SolidColorBrush x:Key="Series4" Color="#eda100" />
          <SolidColorBrush x:Key="Series5" Color="#e87ba4" />
          <LinearGradientBrush x:Key="AreaFade" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#592a78d6" />
            <GradientStop Offset="1" Color="#002a78d6" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SparkFade" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#472a78d6" />
            <GradientStop Offset="1" Color="#002a78d6" />
          </LinearGradientBrush>
          <x:String x:Key="CompareStroke">#a1a1aa</x:String>
          <SolidColorBrush x:Key="CompareBrush" Color="#a1a1aa" />
          <LinearGradientBrush x:Key="StripBg" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#F3F7FD" />
            <GradientStop Offset="1" Color="#FFFFFF" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:String x:Key="PictorPalette1">#3987e5</x:String>
          <x:String x:Key="PictorPalette2">#d95926</x:String>
          <x:String x:Key="PictorPalette3">#199e70</x:String>
          <x:String x:Key="PictorPalette4">#c98500</x:String>
          <x:String x:Key="PictorPalette5">#d55181</x:String>
          <x:String x:Key="PictorGridStroke">#222227</x:String>
          <x:String x:Key="PictorTickText">#8b8b94</x:String>
          <x:String x:Key="PictorCursorStroke">#3f3f46</x:String>
          <x:String x:Key="PictorCursorFill">#1d1d22</x:String>
          <x:String x:Key="PictorTooltipBackground">#18181b</x:String>
          <x:String x:Key="PictorTooltipBorder">#2e2e35</x:String>
          <x:String x:Key="PictorTooltipLabel">#ededf0</x:String>
          <x:String x:Key="PictorPieStroke">#131316</x:String>
          <x:String x:Key="PictorFunnelStroke">#131316</x:String>
          <x:String x:Key="PictorBrushStroke">#71717a</x:String>
          <x:String x:Key="PictorBrushFill">#131316</x:String>
          <x:String x:Key="Step1">#86b6ef</x:String>
          <x:String x:Key="Step2">#5598e7</x:String>
          <x:String x:Key="Step3">#2a78d6</x:String>
          <x:String x:Key="Step4">#1c5cab</x:String>
          <SolidColorBrush x:Key="Series1" Color="#3987e5" />
          <SolidColorBrush x:Key="Series2" Color="#d95926" />
          <SolidColorBrush x:Key="Series3" Color="#199e70" />
          <SolidColorBrush x:Key="Series4" Color="#c98500" />
          <SolidColorBrush x:Key="Series5" Color="#d55181" />
          <LinearGradientBrush x:Key="AreaFade" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#733987e5" />
            <GradientStop Offset="1" Color="#003987e5" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SparkFade" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#663987e5" />
            <GradientStop Offset="1" Color="#003987e5" />
          </LinearGradientBrush>
          <x:String x:Key="CompareStroke">#6b6b74</x:String>
          <SolidColorBrush x:Key="CompareBrush" Color="#6b6b74" />
          <LinearGradientBrush x:Key="StripBg" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#111A2A" />
            <GradientStop Offset="1" Color="#131316" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Border.tile"><Setter Property="Padding" Value="18,16" /></Style>
    <Style Selector="TextBlock.hero"><Setter Property="FontSize" Value="34" /></Style>
    <Style Selector="Border.tone.signup"><Setter Property="Background" Value="{DynamicResource Series1}" /></Style>
    <Style Selector="Border.tone.purchase"><Setter Property="Background" Value="{DynamicResource Positive}" /></Style>
    <Style Selector="Border.tone.error"><Setter Property="Background" Value="{DynamicResource Negative}" /></Style>
    <Style Selector="Border.appicon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.appicon Path">
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="#FFFFFF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-1" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="20" MaxWidth="1360" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" RowSpacing="12" a:Web.StackBelow="900">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="livedot" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Text="LIVE DEMO · DUMMY DATA GENERATED ON THE SERVER" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="h1" Text="Pictor" />
        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                   Text="Aioros.Pictor charts in pure XAML: server-rendered on the web, native on the desktop. Every chart on this page is a Pictor control, updated live by the server." />
      </StackPanel>
      <WrapPanel Grid.Column="1" ItemSpacing="18" LineSpacing="6" VerticalAlignment="Bottom">
        <Border Classes="textlink" a:Web.Href="/line"><TextBlock Text="Chart families →" FontWeight="Medium" /></Border>
        <Border Classes="textlink" a:Web.Href="/interactive"><TextBlock Text="Interactivity →" FontWeight="Medium" /></Border>
        <Border Classes="textlink" a:Web.Href="/themes"><TextBlock Text="Themes →" FontWeight="Medium" /></Border>
        <Border Classes="textlink" a:Web.Href="/about"><TextBlock Text="Getting started →" FontWeight="Medium" /></Border>
      </WrapPanel>
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="12" a:Web.StackBelow="900">
      <WrapPanel ItemSpacing="12" LineSpacing="8">
        <Border Classes="segment">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Border Classes="seg" Classes.on="{Binding WebApp.Selected}" a:Web.Href="{Binding WebApp.Href}" AutomationProperties.Name="Nimbus, the SaaS web app">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="appicon" Background="#2A78D6">
                  <Path Data="M5,12.5 C2.8,12.5 2.4,9.4 4.6,8.9 C4.8,6.3 8.7,5.5 9.9,8 C12.2,7.4 13.4,10 12.2,11.4 C11.8,12.1 11.2,12.5 10.6,12.5 Z" Fill="#FFFFFF" StrokeThickness="0" Width="12" Height="9" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding WebApp.Label}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="seg" Classes.on="{Binding MobileApp.Selected}" a:Web.Href="{Binding MobileApp.Href}" AutomationProperties.Name="Pulse, the mobile app">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="appicon" Background="#D6457A">
                  <Path Data="M1.5,8.5 L4.5,8.5 L6,5 L8.5,12 L10.5,7 L11.5,8.5 L14.5,8.5" Width="12" Height="8" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding MobileApp.Label}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="seg" Classes.on="{Binding ApiApp.Selected}" a:Web.Href="{Binding ApiApp.Href}" AutomationProperties.Name="Relay, the payments API">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="appicon" Background="#12956A">
                  <Path Data="M3,5.5 L12,5.5 M9.5,3 L12,5.5 L9.5,8 M13,10.5 L4,10.5 M6.5,8 L4,10.5 L6.5,13" Width="11" Height="10" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding ApiApp.Label}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <TextBlock Classes="muted small" Text="{Binding Data.Pitch}" VerticalAlignment="Center" />
      </WrapPanel>
      <Border Grid.Column="1" Classes="segment" HorizontalAlignment="Left">
        <ItemsControl ItemsSource="{Binding Data.Ranges}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="an:Choice">
              <Border Classes="seg" Classes.on="{Binding Selected}" a:Web.Href="{Binding Href}">
                <TextBlock Text="{Binding Label}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="3*,7*" ColumnSpacing="16" RowSpacing="16" a:Web.StackBelow="760">
      <v:KpiNow />
      <v:KpiPeriod Grid.Column="1" />
    </Grid>

    <Grid ColumnDefinitions="8*,4*" ColumnSpacing="16" RowSpacing="16" a:Web.StackBelow="860">
      <Border Classes="card">
        <v:TrafficChart />
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="Live events" />
            <Border Grid.Column="1" Classes="livedot" VerticalAlignment="Center" />
          </Grid>
          <v:EventFeed />
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="5*,4*,3*" ColumnSpacing="16" RowSpacing="16" a:Web.StackBelow="860">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="title" Text="{Binding Data.PagesTitle}" />
              <TextBlock Classes="muted small" Text="Click a bar to focus the main chart on it" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" IsVisible="{Binding Focused}" a:Web.Href="{Binding Data.ClearHref}" VerticalAlignment="Center" AutomationProperties.Name="Clear the focus">
              <TextBlock Text="Clear ×" />
            </Border>
          </Grid>
          <p:BarChart Data="{Binding Data.Pages}" Layout="Vertical" Height="252" ResponsiveWidths="360 520" Padding="0,0,48,0" BarCategoryGap="22%">
            <p:XAxis Type="Number" Hide="True" />
            <p:YAxis DataKey="Name" Type="Category" Width="168" TickLine="False" AxisLine="False" />
            <p:Tooltip Cursor="False" />
            <p:Bar DataKey="Value" Name="Views" StackId="pages" Fill="{DynamicResource PictorPalette1}" Radius="0 4 4 0" MaxBarSize="22" ClickCommand="{Binding FocusPage}">
              <p:LabelList DataKey="Text" Position="Right" />
            </p:Bar>
            <p:Bar DataKey="Dimmed" Name="Views" StackId="pages" Fill="{DynamicResource PictorPalette1}" FillOpacity="0.3" Radius="0 4 4 0" MaxBarSize="22" ClickCommand="{Binding FocusPage}">
              <p:LabelList DataKey="Text" Position="Right" />
            </p:Bar>
          </p:BarChart>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="{Binding Data.SourcesTitle}" />
            <TextBlock Classes="muted small" Text="{Binding Data.RangeCaption}" />
          </StackPanel>
          <StackPanel Spacing="16">
            <Panel Width="184" Height="168" HorizontalAlignment="Center">
              <p:PieChart Data="{Binding Data.Sources}" Width="184" Height="168">
                <p:Tooltip />
                <p:Pie DataKey="Value" NameKey="Name" InnerRadius="54" OuterRadius="76" Cx="92" Cy="84" StartAngle="90" EndAngle="-270" PaddingAngle="2" CornerRadius="3">
                  <p:Cell Fill="{DynamicResource PictorPalette1}" />
                  <p:Cell Fill="{DynamicResource PictorPalette2}" />
                  <p:Cell Fill="{DynamicResource PictorPalette3}" />
                  <p:Cell Fill="{DynamicResource PictorPalette4}" />
                  <p:Cell Fill="{DynamicResource PictorPalette5}" />
                </p:Pie>
              </p:PieChart>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Classes="figure" Text="{Binding Data.SourcesTotal}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="muted small" Text="total" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
              <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Classes="swatch" Background="{DynamicResource Series1}" />
                <TextBlock Grid.Column="1" Text="{Binding Source1.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="muted figure" Text="{Binding Source1.Share}" />
              </Grid>
              <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Classes="swatch" Background="{DynamicResource Series2}" />
                <TextBlock Grid.Column="1" Text="{Binding Source2.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="muted figure" Text="{Binding Source2.Share}" />
              </Grid>
              <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Classes="swatch" Background="{DynamicResource Series3}" />
                <TextBlock Grid.Column="1" Text="{Binding Source3.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="muted figure" Text="{Binding Source3.Share}" />
              </Grid>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Classes="swatch" Background="{DynamicResource Series4}" />
                <TextBlock Grid.Column="1" Text="{Binding Source4.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="muted figure" Text="{Binding Source4.Share}" />
              </Grid>
              <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Classes="swatch" Background="{DynamicResource Series5}" />
                <TextBlock Grid.Column="1" Text="{Binding Source5.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Classes="muted figure" Text="{Binding Source5.Share}" />
              </Grid>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="title" Text="{Binding Data.FunnelTitle}" />
              <TextBlock Classes="muted small" Text="Share of the first step" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="figure" Text="{Binding Data.FunnelConversion}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
          <p:FunnelChart Data="{Binding Data.Funnel}" Height="180" Padding="0,4,0,4" ResponsiveWidths="220 320">
            <p:Tooltip />
            <p:Funnel DataKey="Value" NameKey="Name" LastShapeType="Rectangle">
              <p:Cell Fill="{DynamicResource Step1}" />
              <p:Cell Fill="{DynamicResource Step2}" />
              <p:Cell Fill="{DynamicResource Step3}" />
              <p:Cell Fill="{DynamicResource Step4}" />
            </p:Funnel>
          </p:FunnelChart>
          <ItemsControl ItemsSource="{Binding Data.Funnel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="an:Step">
                <Grid ColumnDefinitions="*,Auto,52" ColumnSpacing="8" Margin="0,3">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="muted figure" Text="{Binding Count}" />
                  <TextBlock Grid.Column="2" Classes="figure" Text="{Binding Text}" FontWeight="Medium" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="6*,6*" ColumnSpacing="16" RowSpacing="16" a:Web.StackBelow="860">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="6" a:Web.StackBelow="560">
            <StackPanel Spacing="2">
              <TextBlock Classes="title" Text="{Binding Data.DevicesTitle}" />
              <TextBlock Classes="muted small" Text="{Binding Data.RangeCaption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="swatch" Background="{DynamicResource Series1}" /><TextBlock Classes="muted small" Text="{Binding Device1}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="swatch" Background="{DynamicResource Series2}" /><TextBlock Classes="muted small" Text="{Binding Device2}" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="swatch" Background="{DynamicResource Series3}" /><TextBlock Classes="muted small" Text="{Binding Device3}" /></StackPanel>
            </StackPanel>
          </Grid>
          <p:BarChart Data="{Binding Data.Devices}" Height="220" Padding="0,8,8,0" ResponsiveWidths="400 640">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Label" TickLine="False" AxisLine="False" MinTickGap="24" TickMargin="8" />
            <p:YAxis TickLine="False" AxisLine="False" TickCount="4" Width="44" TickFormat="{Binding Data.DevicesFormat}" />
            <p:Tooltip />
            <p:Bar DataKey="First" Name="{Binding Device1}" StackId="devices" Fill="{DynamicResource PictorPalette1}" MaxBarSize="24" />
            <p:Bar DataKey="Second" Name="{Binding Device2}" StackId="devices" Fill="{DynamicResource PictorPalette2}" MaxBarSize="24" />
            <p:Bar DataKey="Third" Name="{Binding Device3}" StackId="devices" Fill="{DynamicResource PictorPalette3}" MaxBarSize="24" Radius="4 4 0 0" />
          </p:BarChart>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Busiest hours" />
            <TextBlock Classes="muted small" Text="A typical week, by weekday and two-hour slot" />
          </StackPanel>
          <StackPanel Spacing="0">
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Mon" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Monday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Mon" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Tue" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Tuesday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Tue" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Wed" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Wednesday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Wed" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Thu" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Thursday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Thu" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Fri" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Friday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Fri" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Sat" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Saturday}" Height="26" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Hide="True" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Sat" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
            <Grid ColumnDefinitions="40,*">
              <TextBlock Classes="muted small" Text="Sun" VerticalAlignment="Top" Margin="0,6,0,0" />
              <p:ScatterChart Grid.Column="1" Data="{Binding Sunday}" Height="52" Padding="0,0,12,0" ResponsiveWidths="480">
                <p:XAxis Type="Number" DataKey="Hour" Domain="-1, 23" Ticks="0, 6, 12, 18" TickFormat="{}{0:00}:00" TickLine="False" AxisLine="False" />
                <p:YAxis Type="Number" DataKey="Row" Hide="True" Domain="0, 2" />
                <p:ZAxis DataKey="Value" Domain="0, 100" Range="4,240" Name="Share of the busiest slot" Unit="%" />
                <p:Tooltip Cursor="False" />
                <p:Scatter Name="Sun" Fill="{DynamicResource PictorPalette1}" IsAnimationActive="False" />
              </p:ScatterChart>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Two charts, one cursor" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Hover either chart: SyncId shows the same moment in both, on the web through CSS and on the desktop through the charts' sync group." />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="16" a:Web.StackBelow="700">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{Binding Data.SyncFirst}" />
            <p:LineChart Data="{Binding Data.Sync}" Height="180" Padding="0,8,8,0" SyncId="dashboard" ResponsiveWidths="400 640">
              <p:CartesianGrid Vertical="False" />
              <p:XAxis DataKey="Label" TickLine="False" AxisLine="False" MinTickGap="40" TickMargin="8" />
              <p:YAxis TickLine="False" AxisLine="False" TickCount="4" Width="44" TickFormat="{Binding Data.SyncFirstFormat}" />
              <p:Tooltip />
              <p:Line Type="Monotone" DataKey="Users" Name="{Binding Data.SyncFirst}" Stroke="{DynamicResource PictorPalette1}" StrokeWidth="2" Dot="False" />
            </p:LineChart>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="label" Text="{Binding Data.SyncSecond}" />
            <p:LineChart Data="{Binding Data.Sync}" Height="180" Padding="0,8,8,0" SyncId="dashboard" ResponsiveWidths="400 640">
              <p:CartesianGrid Vertical="False" />
              <p:XAxis DataKey="Label" TickLine="False" AxisLine="False" MinTickGap="40" TickMargin="8" />
              <p:YAxis TickLine="False" AxisLine="False" TickCount="4" Width="44" TickFormat="{Binding Data.SyncSecondFormat}" />
              <p:Tooltip />
              <p:Line Type="Monotone" DataKey="Sessions" Name="{Binding Data.SyncSecond}" Stroke="{DynamicResource PictorPalette2}" StrokeWidth="2" Dot="False" />
            </p:LineChart>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card" Background="{DynamicResource StripBg}" Padding="24">
      <Grid ColumnDefinitions="7*,5*" ColumnSpacing="32" RowSpacing="20" a:Web.StackBelow="1000">
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" Text="HOW THIS WORKS" />
          <TextBlock Classes="h2" TextWrapping="Wrap" Text="One XAML page, two targets, no script of its own" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="This page is an Aioros page written in XAML. On the web, the server writes every chart as SVG from the page's compiled plan, with tooltips and hover states in CSS: the app writes no JavaScript. A hosted service ticks once a second and invalidates a data key; only the views that read it (the live tile, the main chart and the event feed) are rendered again and pushed as regions; the period tiles follow each minute. The same XAML runs natively on the desktop, where the charts draw through Avalonia." />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Pictor is an independent port of Recharts and is not affiliated with or endorsed by the Recharts project. Recharts is MIT-licensed; see THIRD-PARTY-NOTICES." />
          <WrapPanel ItemSpacing="18" LineSpacing="6">
            <Border Classes="textlink" a:Web.Href="/about"><TextBlock Text="Getting started →" FontWeight="Medium" /></Border>
            <Border Classes="textlink" a:Web.Href="/interactive"><TextBlock Text="Interactive charts →" FontWeight="Medium" /></Border>
            <Border Classes="textlink" a:Web.Href="/themes"><TextBlock Text="Theming →" FontWeight="Medium" /></Border>
          </WrapPanel>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Classes="big figure" Text="96×" />
            <TextBlock Classes="small" TextWrapping="Wrap" FontWeight="Medium" Text="faster than Recharts on the server" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="geometric mean over 42 examples (24×–181×)" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="big figure" Text="4.3×" />
            <TextBlock Classes="small" TextWrapping="Wrap" FontWeight="Medium" Text="faster to show in Chromium" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="geometric mean over 42 examples (1.2–8.3×)" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted small" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Measured in performance history on the lab runner: Pictor's WriteSvg against Recharts' renderToStaticMarkup (iteration 12, 2026-10-15), and Pictor's markup shown against React mounting Recharts (iteration 11, the markup unchanged since)." />
        </Grid>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
