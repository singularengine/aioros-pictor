<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="https://aioros.dev/pictor" xmlns:t="using:Aioros.Pictor.Tests.Desktop"
             x:Class="Aioros.Pictor.Tests.Desktop.BoundBrushView" x:DataType="t:BoundBrushModel">
  <p:BarChart x:Name="Chart" Data="{Binding Items}" Width="500" Height="300">
    <p:XAxis DataKey="Name" />
    <p:YAxis />
    <p:Brush DataKey="Name" StartIndex="{Binding Start}" EndIndex="{Binding End}" />
    <p:Bar DataKey="Value" />
  </p:BarChart>
</UserControl>
