<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Aioros contributors</Authors>
    <Copyright>Copyright (c) 2026 Aioros contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/singularengine/aioros-pictor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/singularengine/aioros-pictor.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>charts;recharts;svg;avalonia;xaml;aioros</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>pictor-128.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../assets/icon/pictor-128.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../tools/recharts/fonts/Inter-LICENSE.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
