<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Classes="h1" Text="Page not found" />
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="The page you are looking for does not exist." />
    <HyperlinkButton NavigateUri="/" Content="Go to the dashboard" />
  </StackPanel>
</UserControl>
