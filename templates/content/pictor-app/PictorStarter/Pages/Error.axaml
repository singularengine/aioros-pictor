<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Classes="h1" Text="Something went wrong" />
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="The page could not be shown. Try again in a moment." />
    <HyperlinkButton NavigateUri="/" Content="Go to the dashboard" />
  </StackPanel>
</UserControl>
