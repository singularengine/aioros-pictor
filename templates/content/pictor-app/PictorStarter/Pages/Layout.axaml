<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" a:Page.Title="PictorStarter" a:Page.TitleTemplate="%s · PictorStarter">
  <DockPanel Background="{DynamicResource AppBg}">
    <Border DockPanel.Dock="Top" Padding="24,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
      <DockPanel>
        <HyperlinkButton DockPanel.Dock="Right" NavigateUri="/theme/toggle" Content="Light / dark" VerticalAlignment="Center" />
        <TextBlock Text="PictorStarter" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Border Padding="24" MaxWidth="1280">
        <a:Outlet />
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
